{
    "name": "@peppermint-digital/vault",
    "version": "0.2.0",
    "description": "Die Browser-Haelfte zu peppermint/vault: Ordnerbaum, Dateiansicht mit Konfliktschutz, Versionen, Papierkorb, Freigaben und die Anbindung an die JSON-Schiene des PHP-Pakets.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^30.0.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.45.0",
        "tailwind-merge": "^3.2.0"
    }
}
